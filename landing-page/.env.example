# Firebase configuration for the web version of the game (/juego).
# Copy this file to `.env.local` and fill with your Firebase project values.
# All keys MUST be prefixed with NEXT_PUBLIC_ to be exposed to the client bundle.
#
# WARNING: these values are public by design (they ship in the browser bundle).
# Security is enforced by Firestore Rules + Firebase Auth, not by secret keys.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Agricultural event. SERVER ONLY: never prefix these with NEXT_PUBLIC_.
# Development defaults to local disk; Vercel requires Firestore.
# AGRO_STORE=firestore
AGRO_FIREBASE_PROJECT_ID=your-project-id
# Create a separate named database and deploy firestore.agro.rules to it.
AGRO_FIRESTORE_DATABASE_ID=agro
# Full service-account JSON, provided securely by the hosting environment.
AGRO_FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use GOOGLE_APPLICATION_CREDENTIALS with an absolute local credential path.
AGRO_ADMIN_KEY=
AGRO_PUBLIC_URL=https://your-event-domain.example
