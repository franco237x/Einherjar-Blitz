{
  "expo": {
    "name": "Einherjar Blitz",
    "owner": "franco237x",
    "slug": "einherjar-blitz",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "einherjar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.einherjar.blitz",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Selecciona una imagen de tu galería para usarla como avatar."
      }
    },
    "android": {
      "package": "com.einherjar.blitz",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona una imagen de tu galería para usarla como avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "58c54303-04b5-4f45-acde-862f7c0a8839"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58c54303-04b5-4f45-acde-862f7c0a8839"
    }
  }
}
