rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Admin account can read/write any user document
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@einherjarblitz.com';
    }

    // Rarity & type whitelists for inventory items
    function validRarity(r) {
      return r is string && r in ['mythic', 'legendary', 'epic', 'rare', 'common'];
    }
    function validItemType(t) {
      return t is string && t in ['persona', 'invocacion', 'otros'];
    }

    // Battle reward constants — must match battleService.ts VICTORY_REWARDS.
    function VICTORY_COPAS() { return 10; }
    function VICTORY_SPHERES() { return 5; }
    function VICTORY_XP() { return 15; }

    // Validates that a rank string is consistent with a copas value.
    // Used to prevent clients from writing an arbitrary rank.
    function rankForCopas(copas) {
      return copas >= 800 ? 'Einherjar'
        : copas >= 500 ? 'Elite'
        : copas >= 300 ? 'Veterano'
        : copas >= 150 ? 'Guerrero'
        : copas >= 50 ? 'Recluta'
        : 'Iniciado';
    }

    // ─── User profile ──────────────────────────────────────────────────
    // Owner can read/write own profile.
    // Any signed-in user can READ other users' profiles (needed for the
    // key-transfer user search). Only the owner or admin can write.
    //
    // ─── SPARK PLAN SECURITY MODEL ─────────────────────────────────────
    // The project is on the Spark (free) plan — no Cloud Functions are
    // available. Without a server-side validator we cannot prove a battle
    // actually occurred. The defenses below are the maximum possible in
    // Spark:
    //
    // 1. FIXED INCREMENTS — battle reward updates must change economy
    //    fields by EXACTLY the hardcoded deltas. A client cannot inject
    //    `copas: 999999`; the rules reject any other delta.
    // 2. ANTI-REPLAY (BEST-EFFORT) — a battle reward update that touches
    //    `victorias` or `derrotas` is only allowed if a corresponding
    //    battle record exists at users/{uid}/game/battles/{battleId}.
    //    The battle record collection is create-only, so the same
    //    battleId cannot be reused. A determined attacker can still farm
    //    by generating fresh battleIds; this is the inherent Spark limit.
    // 3. RANK CONSISTENCY — `rango` must match `rankForCopas(newCopas)`.
    //
    // TODO: upgrade to Blaze and deploy the Cloud Function in
    // mobile/functions/ to close the farm-by-fresh-battleId hole.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();

      // ─── Owner profile updates (username, frase, avatar, economy) ───
      // Allows the owner to update profile + economy fields (gacha, store,
      // index tabs) EXCEPT the battle-only counters, which have a dedicated
      // rule below that enforces fixed increments + anti-replay.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['victorias', 'derrotas', 'jefes_derrotados', 'nivel', 'horas_jugadas', 'createdAt']);

      // ─── Battle victory reward update ───────────────────────────────
      // Triggered by battleService.saveBattleVictory. Validates:
      //  - Only the expected fields change.
      //  - Each economy field increments by exactly the hardcoded delta.
      //  - `rango` is consistent with the new copas total.
      //  - A battle record exists at the provided battleId path.
      //    NOTE: Firestore Rules cannot read the battleId from the update
      //    payload, so the anti-replay check uses a wildcard match on the
      //    battles subcollection — any existing battle record satisfies
      //    this rule. The create-only semantics on battles/{battleId}
      //    prevent reusing the same battleId, which is the actual
      //    anti-replay mechanism.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['copas', 'victorias', 'jefes_derrotados', 'spheres', 'experiencia', 'rango'])
        && request.resource.data.copas == resource.data.copas + VICTORY_COPAS()
        && request.resource.data.victorias == resource.data.victorias + 1
        && request.resource.data.jefes_derrotados == resource.data.jefes_derrotados + 1
        && request.resource.data.spheres == resource.data.spheres + VICTORY_SPHERES()
        && request.resource.data.experiencia == resource.data.experiencia + VICTORY_XP()
        && request.resource.data.rango == rankForCopas(resource.data.copas + VICTORY_COPAS());

      // ─── Battle defeat reward update ────────────────────────────────
      // Only `derrotas` may change, and only by +1.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['derrotas'])
        && request.resource.data.derrotas == resource.data.derrotas + 1;

      // Allow any signed-in user to INCREMENT the keys field on another user's
      // document (for receiving key transfers). Only the keys field may change
      // and it must be an increase (recipient gains keys).
      allow update: if isSignedIn()
        && !isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['keys'])
        && request.resource.data.keys is int
        && request.resource.data.keys > resource.data.keys;
    }

    // ─── Battle records (anti-replay ledger) ───────────────────────────
    // One doc per completed battle. CREATE-ONLY: the owner may create a
    // doc here, but never update or delete it. Firestore rejects a create
    // if the doc already exists, which is the anti-replay mechanism.
    // Schema is validated on create to match battleService.createBattleRecord.
    match /users/{userId}/game/battles/{battleId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.result is string
        && request.resource.data.result in ['victory', 'defeat']
        && request.resource.data.charId is string
        && request.resource.data.charId.size() > 0
        && request.resource.data.charId.size() <= 40
        && request.resource.data.bossId is string
        && request.resource.data.bossId.size() > 0
        && request.resource.data.bossId.size() <= 80
        && request.resource.data.turns is int
        && request.resource.data.turns >= 1
        && request.resource.data.turns <= 200
        && request.resource.data.completedAt is timestamp;
      allow update, delete: if false;
    }

    // ─── Game module profile (isolated progression, future use) ───────
    // Reserved for future battle-only progression fields when the Cloud
    // Function is deployed. Currently unused (jefes_derrotados stays on
    // the user doc for Spark compatibility). Owner read-only.
    match /users/{userId}/game/profile {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ─── Inventory (gacha rewards) ─────────────────────────────────────
    // Each pull writes one doc. Schema is strictly validated on create.
    // Owner can delete an item when claiming it via PDF (no updates allowed).
    match /users/{userId}/inventory/{itemId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && validItemType(request.resource.data.type)
        && validRarity(request.resource.data.rarity)
        && request.resource.data.obtainedAt is timestamp
        && (request.resource.data.bannerId is string
            || !('bannerId' in request.resource.data));

      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ─── Store: Products ──────────────────────────────────────────────
    // Products are managed from the dashboard (admin). Clients can only read.
    // Stock updates happen via runTransaction from the client — the transaction
    // reads the doc and writes a decremented stock. This is allowed because the
    // user is signed in and we trust the transaction logic (no price/name changes).
    match /products/{productId} {
      allow read: if isSignedIn();
      // Allow stock decrement via transaction (only the stock field changes)
      allow update: if isSignedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.price == resource.data.price
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
      allow create, delete: if false;
    }

    // ─── Store: Purchase history ──────────────────────────────────────
    // Each purchase writes one doc. Owner can read their own history.
    // Owner can delete a purchase when claiming it via PDF (no updates allowed).
    match /users/{userId}/purchases/{purchaseId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 80
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.purchasedAt is timestamp;

      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ─── Default deny ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
