# Firebase configuration for the mobile app.
# Copy this file to `.env` and fill with your Firebase project values.
# All keys MUST be prefixed with EXPO_PUBLIC_ to be exposed to the client bundle.
#
# WARNING: these values are public by design (they ship in the app binary).
# Security is enforced by Firestore Rules + Firebase Auth, not by secret keys.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Optional: Cloud Functions region (defaults to us-central1 if omitted).
# Set this only if you deploy your functions to a different region.
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1
